variable "name_prefix" {
  description = "Prefix applied to resource names."
  type        = string
}

variable "vpc_id" {
  description = "VPC ID."
  type        = string
}

variable "subnet_id" {
  description = "Subnet ID for the RDS instance."
  type        = string
}

variable "security_group_id" {
  description = "Security group allowing 5432 from the workload subnets."
  type        = string
}

variable "availability_zones" {
  description = "Two availability zones for the primary/standby instance. RDS places the standby in the second zone."
  type        = list(string)

  validation {
    condition     = length(var.availability_zones) == 2
    error_message = "Exactly two availability zones are required for a primary/standby RDS instance."
  }
}

variable "flavor" {
  description = "RDS flavor code, for example rds.pg.n1.xlarge.2.ha. Flavor codes are region specific - verify with `data.huaweicloud_rds_flavors` before changing regions."
  type        = string
  default     = "rds.pg.n1.xlarge.2.ha"
}

variable "engine_version" {
  description = "PostgreSQL major version."
  type        = string
  default     = "16"
}

variable "volume_type" {
  description = "Storage type: CLOUDSSD, ULTRAHIGH or LOCALSSD. Availability depends on the flavor and region."
  type        = string
  default     = "CLOUDSSD"
}

variable "volume_size" {
  description = "Storage size in GB."
  type        = number
  default     = 100
}

variable "ha_replication_mode" {
  description = "Replication mode for the standby: async or sync."
  type        = string
  default     = "async"

  validation {
    condition     = contains(["async", "sync"], var.ha_replication_mode)
    error_message = "ha_replication_mode must be async or sync."
  }
}

variable "backup_start_time" {
  description = "Backup window in HH:MM-HH:MM (UTC) format."
  type        = string
  default     = "18:00-19:00"
}

variable "backup_keep_days" {
  description = "Number of days to retain automated backups."
  type        = number
  default     = 7
}

variable "database_name" {
  description = "Database created for LiteLLM."
  type        = string
  default     = "litellm"
}

variable "password" {
  description = "Password of the RDS administrator account. Generated by the caller and stored in CSMS."
  type        = string
  sensitive   = true

  validation {
    condition     = length(var.password) >= 8 && length(var.password) <= 32
    error_message = "RDS passwords must be 8-32 characters long."
  }
}

variable "kms_key_id" {
  description = "KMS key ID used to encrypt the data volume. Null disables disk encryption."
  type        = string
  default     = null
}

variable "charging_mode" {
  description = "postPaid or prePaid."
  type        = string
  default     = "postPaid"

  validation {
    condition     = contains(["postPaid", "prePaid"], var.charging_mode)
    error_message = "charging_mode must be postPaid or prePaid."
  }
}

variable "period" {
  description = "Billing period when charging_mode is prePaid."
  type        = number
  default     = 1
}

variable "period_unit" {
  description = "Billing period unit when charging_mode is prePaid: month or year."
  type        = string
  default     = "month"
}

variable "enterprise_project_id" {
  description = "Enterprise project ID."
  type        = string
  default     = "0"
}

variable "tags" {
  description = "Tags applied to every resource."
  type        = map(string)
  default     = {}
}
