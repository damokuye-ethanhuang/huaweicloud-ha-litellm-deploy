variable "name_prefix" {
  description = "Deprecated: kept for compatibility. Names come from `names`, see the naming module."
  type        = string
  default     = ""
}

variable "names" {
  description = "Name map from terraform/modules/naming. Selectors: dcs"
  type        = map(string)
}

variable "vpc_id" {
  description = "VPC ID."
  type        = string
}

variable "subnet_id" {
  description = "Subnet ID for the DCS instance."
  type        = string
}

variable "security_group_id" {
  description = "Security group allowing 6379 from the workload subnets."
  type        = string
}

variable "availability_zones" {
  description = "Two availability zones for the primary/standby cache."
  type        = list(string)

  validation {
    condition     = length(var.availability_zones) == 2
    error_message = "Exactly two availability zones are required for a primary/standby DCS instance."
  }
}

variable "engine_version" {
  description = "Redis version. Verify the versions offered in your region (7.0 is available in most regions)."
  type        = string
  default     = "7.0"
}

variable "capacity" {
  description = "Cache capacity in GB."
  type        = number
  default     = 2
}

variable "flavor" {
  description = "DCS flavor code, for example redis.ha.xu1.large.r2.2 (primary/standby, 2 replicas, 2 GB). Leave empty to look it up with the huaweicloud_dcs_flavors data source."
  type        = string
  default     = "redis.ha.xu1.large.r2.2"
}

variable "password" {
  description = "Redis password. Generated by the caller and stored in CSMS."
  type        = string
  sensitive   = true

  validation {
    condition     = length(var.password) >= 8 && length(var.password) <= 32
    error_message = "DCS passwords must be 8-32 characters long."
  }
}

variable "ssl_enable" {
  description = "Enable TLS on the DCS instance. LiteLLM then needs REDIS_SSL=true and the rediss:// scheme for the cache."
  type        = bool
  default     = false
}

variable "charging_mode" {
  description = "postPaid or prePaid."
  type        = string
  default     = "postPaid"

  validation {
    condition     = contains(["postPaid", "prePaid"], var.charging_mode)
    error_message = "charging_mode must be postPaid or prePaid."
  }
}

variable "period" {
  description = "Billing period when charging_mode is prePaid."
  type        = number
  default     = 1
}

variable "period_unit" {
  description = "Billing period unit when charging_mode is prePaid: month or year."
  type        = string
  default     = "month"
}

variable "enterprise_project_id" {
  description = "Enterprise project ID."
  type        = string
  default     = "0"
}

variable "tags" {
  description = "Tags applied to every resource."
  type        = map(string)
  default     = {}
}
