variable "name_prefix" {
  description = "Deprecated: kept for compatibility. Names come from `names`, see the naming module."
  type        = string
  default     = ""
}

variable "names" {
  description = "Name map from terraform/modules/naming. Selectors: cce, cce_pool"
  type        = map(string)
}

variable "vpc_id" {
  description = "VPC ID."
  type        = string
}

variable "subnet_id" {
  description = "Subnet for the cluster control plane and worker nodes."
  type        = string
}

variable "eni_subnet_ids" {
  description = "ENI subnet IDs for CCE Turbo pod networking. Ignored for overlay networking."
  type        = list(string)
  default     = []
}

variable "container_network_type" {
  description = "Container network type: vpc-router (ipvlan, VPC routes), overlay_l2 (VXLAN) or eni (CCE Turbo)."
  type        = string
  default     = "vpc-router"

  validation {
    condition     = contains(["vpc-router", "overlay_l2", "eni"], var.container_network_type)
    error_message = "container_network_type must be vpc-router, overlay_l2 or eni."
  }
}

variable "charging_mode" {
  description = "postPaid or prePaid for the cluster and its nodes."
  type        = string
  default     = "postPaid"

  validation {
    condition     = contains(["postPaid", "prePaid"], var.charging_mode)
    error_message = "charging_mode must be postPaid or prePaid."
  }
}

variable "period" {
  description = "Billing period when prePaid."
  type        = number
  default     = 1
}

variable "period_unit" {
  description = "month or year when prePaid."
  type        = string
  default     = "month"
}

variable "ops_cidr" {
  description = "Ops subnet CIDR allowed to reach the cluster API on 6443. Empty disables the rule."
  type        = string
  default     = ""
}

variable "container_network_cidr" {
  description = "Pod CIDR for overlay networking. Must not overlap the VPC CIDR."
  type        = string
  default     = "172.16.0.0/16"
}

variable "cluster_flavor" {
  description = "CCE cluster flavor, for example cce.s2.small (up to 50 nodes)."
  type        = string
  default     = "cce.s2.small"
}

variable "cluster_version" {
  description = "Kubernetes version, for example v1.31. Leave empty to let CCE pick the current default for the region."
  type        = string
  default     = ""
}

variable "availability_zones" {
  description = "Availability zones for the three control plane masters and the worker node pools."
  type        = list(string)

  validation {
    condition     = length(var.availability_zones) >= 2
    error_message = "At least two availability zones are required."
  }
}

variable "node_flavor" {
  description = "Worker node flavor, for example c7.xlarge.4 (4 vCPU / 16 GiB). Flavor codes are region specific."
  type        = string
  default     = "c7.xlarge.4"
}

variable "node_count_per_az" {
  description = "Worker nodes created in each availability zone."
  type        = number
  default     = 1

  validation {
    condition     = var.node_count_per_az >= 1
    error_message = "node_count_per_az must be at least 1."
  }
}

variable "node_password" {
  description = "Password for the worker node root account. Generated by the caller; SSH is not required for normal operation."
  type        = string
  sensitive   = true
}

variable "node_os" {
  description = "Worker node OS image. Leave empty to use the CCE default image for the region."
  type        = string
  default     = ""
}

variable "root_volume_size" {
  description = "System disk size in GB."
  type        = number
  default     = 50
}

variable "root_volume_type" {
  description = "System disk type: SSD, SAS, SATA or GPSSD."
  type        = string
  default     = "SSD"
}

variable "data_volume_size" {
  description = "Data disk size in GB. Used for the container runtime and images."
  type        = number
  default     = 100
}

variable "data_volume_type" {
  description = "Data disk type: SSD, SAS, SATA or GPSSD."
  type        = string
  default     = "SSD"
}

variable "kms_key_id" {
  description = "KMS key ID used to encrypt node disks. Null disables encryption."
  type        = string
  default     = null
}

variable "enterprise_project_id" {
  description = "Enterprise project ID."
  type        = string
  default     = "0"
}

variable "tags" {
  description = "Tags applied to every resource."
  type        = map(string)
  default     = {}
}
