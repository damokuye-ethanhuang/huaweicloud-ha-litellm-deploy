variable "name_prefix" {
  description = "Deprecated: kept for compatibility. Names come from `names`."
  type        = string
  default     = ""
}

variable "names" {
  description = "Name map from terraform/modules/naming. Selector: bastion."
  type        = map(string)
}

variable "vpc_id" {
  description = "VPC ID."
  type        = string
}

variable "subnet_id" {
  description = "Subnet for the bastion. Should be the application subnet so it can reach the CCE API and nodes."
  type        = string
}

variable "security_group_id" {
  description = "Security group for the bastion: outbound to the VPC only, inbound SSH from the allowed ranges."
  type        = string
}

variable "availability_zone" {
  description = "Availability zone for the bastion instance."
  type        = string
}

variable "flavor_id" {
  description = "ECS flavor. The bastion only runs kubectl/helm, so 2 vCPU / 4 GiB is enough."
  type        = string
  default     = "c7.large.2"
}

variable "image_name" {
  description = "IMS image name for the bastion OS."
  type        = string
  default     = "Ubuntu 24.04 server 64bit"
}

variable "system_disk_size" {
  description = "System disk size in GB."
  type        = number
  default     = 40
}

variable "system_disk_type" {
  # GPSSD2 would be preferred, but huaweicloud_compute_instance exposes no
  # iops/throughput for the system disk and the API rejects GPSSD2 without them
  # ("GPSSD2 volume type both iops and throughput are required"). GPSSD needs
  # neither, so it is the fastest disk this resource can actually request.
  description = "System disk type: GPSSD, GPSSD2 (needs iops/throughput, unsupported here), SSD or SAS."
  type        = string
  default     = "GPSSD"
}

variable "admin_password" {
  description = "Password for the default admin account. Generated by the caller and stored in CSMS."
  type        = string
  sensitive   = true
}

variable "key_pair" {
  description = "Existing key pair name. Optional; used when SSH keys are preferred over the password."
  type        = string
  default     = ""
}

variable "eip_type" {
  description = <<-EOT
    EIP line type.

    5_bgp (dynamic BGP) is the right default everywhere:
      - mainland China regions: the "中国大陆访问" line, best routing for
        domestic operators.
      - overseas regions: the direct/origin line; there is no separate
        "China access" line to select there.
    Only change this if your account is restricted to a carrier line
    (5_telcom / 5_unicom / 5_mobile) or static BGP (5_sbgp).
  EOT
  type        = string
  default     = "5_bgp"

  validation {
    condition     = contains(["5_bgp", "5_sbgp", "5_telcom", "5_unicom", "5_mobile"], var.eip_type)
    error_message = "eip_type must be one of 5_bgp, 5_sbgp, 5_telcom, 5_unicom, 5_mobile."
  }
}

variable "eip_bandwidth_size" {
  description = "Bandwidth in Mbit/s of the pay-per-use EIP attached to the bastion."
  type        = number
  default     = 10
}

variable "eip_charge_mode" {
  description = "EIP billing mode: traffic (pay per GB, default) or bandwidth."
  type        = string
  default     = "traffic"

  validation {
    condition     = contains(["traffic", "bandwidth"], var.eip_charge_mode)
    error_message = "eip_charge_mode must be traffic or bandwidth."
  }
}

variable "auto_release_on_delete" {
  description = "Release the EIP when the bastion is destroyed. Keep true for cost control."
  type        = bool
  default     = true
}

variable "install_tools" {
  description = "Bootstrap kubectl and helm on first boot via cloud-init."
  type        = bool
  default     = true
}

variable "kubectl_version" {
  description = "kubectl version to install on the bastion. Keep it within one minor version of the cluster (see cce_cluster_version)."
  type        = string
  # 1.31 vs a 1.36 cluster is five minors apart; kubectl only supports +/-1.
  default = "v1.36.0"
}

variable "helm_version" {
  description = "helm version to install on the bastion."
  type        = string
  default     = "v3.16.3"
}

variable "enterprise_project_id" {
  description = "Enterprise project ID."
  type        = string
  default     = "0"
}

variable "tags" {
  description = "Tags applied to every resource."
  type        = map(string)
  default     = {}
}

variable "ssh_public_key" {
  description = "Public key written into /root/.ssh/authorized_keys at first boot. The image's own keypair injection does not reach the guest, so this is the primary path."
  type        = string
  default     = ""
}
