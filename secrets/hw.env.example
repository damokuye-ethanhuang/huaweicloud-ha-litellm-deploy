# AK/SK for the Huawei Cloud account this stack is deployed into.
#
# This is the one place credentials are filled in. `scripts/creds.sh set` writes
# it interactively (no echo, chmod 600); `scripts/creds.sh clear` puts it back to
# the placeholders below. The file is gitignored - never paste real values into
# deploy-inputs.yaml, an issue, or a chat message.
#
# Use a dedicated IAM user with the permissions listed in docs/security.md, not
# the account owner.
HW_ACCESS_KEY=
HW_SECRET_KEY=
# Optional: only needed when the IAM user is not in the default project.
HW_PROJECT_ID=
# Optional: defaults to the region in deploy-inputs.yaml.
HW_REGION=
